<resources>
    <style name="Theme.Puzzler" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <!-- Launch splash on every Android version; the intro takes over from its icon. -->
    <style name="Theme.Puzzler.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_orb</item>
        <item name="postSplashScreenTheme">@style/Theme.Puzzler</item>
    </style>
</resources>
